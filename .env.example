# eFootball Mobile Ghana Championship Platform Environment Variables

# Node Environment
NODE_ENV=development

# Application Public Hostname (Configured for Twitch Parent verification)
NEXT_PUBLIC_APP_DOMAIN=localhost
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Vercel Domain (Automatically provided on Vercel deployment)
# VERCEL_URL=your-project.vercel.app

# Optional Supabase / PostgreSQL Credentials (if migrating from file-based persistent DB)
# DATABASE_URL=postgresql://user:password@localhost:5432/efootball_db
# NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
